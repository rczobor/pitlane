{
  "manifest_version": 3,
  "name": "Pitlane",
  "version": "0.1.0",
  "description": "Save the car listing you are looking at to your Pitlane board.",
  "minimum_chrome_version": "120",
  "action": { "default_popup": "popup.html", "default_title": "Save to Pitlane" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
