{
  "manifest_version": 3,
  "name": "Pitlane",
  "version": "0.2.0",
  "description": "Save the car listing you are looking at to your Pitlane board.",
  "minimum_chrome_version": "120",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Pitlane"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ]
}
