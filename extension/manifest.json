{
  "manifest_version": 3,
  "name": "Pitlane",
  "version": "0.3.2",
  "description": "Save the car listing you are looking at to your Pitlane board.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "action": {
    "default_title": "Save to Pitlane",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.mobile.de/*"
  ]
}
